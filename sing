    print("Initializing MaxMind GeoLite2 databases...")
    init_geo_readers()

    set_terminal_title(SERVERS[0].get("tab_name", "sing-box"))
    try:
        curses.wrapper(draw_ui)
    except KeyboardInterrupt:
        sys.exit(0)


