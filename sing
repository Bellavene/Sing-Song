def geo_db_path(kind):
    key = f"geoip_{kind}_mmdb"
    return os.path.expanduser(CONFIG.get(key) or
                                 os.path.join(os.path.dirname(CONFIG_PATH), GEOIP_DB_FILES[kind]["name"]))


def download_geo_db(kind, dest_path):
    url = GEOIP_DB_FILES[kind]["url"]
    tmp_path = dest_path + ".tmp"
    print(f"Downloading {GEOIP_DB_FILES[kind]['name']}...")
    req = urllib.request.Request(url, headers={"User-Agent": "singbox-tui"})
    with urllib.request.urlopen(req, timeout=120) as resp, open(tmp_path, "wb") as f:
        while True:
            chunk = resp.read(65536)
            if not chunk:
                break
            f.write(chunk)
    os.replace(tmp_path, dest_path)
    print(f"Successfully downloaded {GEOIP_DB_FILES[kind]['name']}")


def geo_db_needs_update(path):
    if not os.path.exists(path):
        return True
    try:
        if os.path.getsize(path) < 10240:
            return True
        return (time.time() - os.path.getmtime(path)) >= GEOIP_UPDATE_INTERVAL
    except OSError:
        return True


def init_geo_readers():
    global GEO_READER, ASN_READER, GEO_LOAD_ERROR
    errors = []
    cpath = geo_db_path("country")
    apath = geo_db_path("asn")

    for kind, path in [("country", cpath), ("asn", apath)]:
        if geo_db_needs_update(path):
            try:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                download_geo_db(kind, path)
            except Exception as e:
                errors.append(f"{kind} db download failed: {e}")

    if os.path.exists(cpath):
        try:
            GEO_READER = maxminddb.open_database(cpath)
            GEO_CACHE.clear()
        except Exception as e:
            errors.append(f"country db: {e}")
    else:
        errors.append(f"country db not found: {cpath}")

    if os.path.exists(apath):
        try:
            ASN_READER = maxminddb.open_database(apath)
        except Exception as e:
            errors.append(f"asn db: {e}")
    else:
        errors.append(f"asn db not found: {apath}")

    GEO_LOAD_ERROR = "; ".join(errors) if errors else None


def geo_db_updater_loop():
    global GEO_LOAD_ERROR
    while True:
        time.sleep(3600)
        try:
            changed = False
            for kind in ("country", "asn"):
                path = geo_db_path(kind)
                if geo_db_needs_update(path):
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    download_geo_db(kind, path)
                    changed = True
            if changed:
                with GEO_RELOAD_LOCK:
                    GEO_LOAD_ERROR = None
                    init_geo_readers()
        except Exception as e:
            with GEO_RELOAD_LOCK:
                GEO_LOAD_ERROR = f"Geo DB download failed: {e}"


def is_valid_ip(target):
    if not target or target in ["-", "127.0.0.1", "::1"]:
        return False
    try:
        socket.inet_aton(target)
        return True
    except socket.error:
        try:
            socket.inet_pton(socket.AF_INET6, target)
            return True
        except socket.error:
            return False


def lookup_geo(target):
    if not target or target in ["-", "127.0.0.1", "::1"]:
        return {"ip": target or "-", "error": "Invalid / Local Target"}

    query_ip = target
    query_host = None
    if not is_valid_ip(target):
        try:
            query_ip = socket.gethostbyname(target)
            query_host = target
        except Exception:
            query_host = target

    cache_key = query_ip if is_valid_ip(query_ip) else query_host
    cached = GEO_CACHE.get(cache_key)
    if cached and not cached.get("error"):
        return cached

    res = {"ip": query_ip if is_valid_ip(query_ip) else cache_key, "host": query_host}
    if GEO_LOAD_ERROR and not GEO_READER:
        res["error"] = f"Geo DB: {GEO_LOAD_ERROR}"
        return res

    try:
        if GEO_READER:
            cdata = GEO_READER.get(query_ip) or {}
            country = (cdata.get("country") or {}).get("iso_code") \
                or (cdata.get("registered_country") or {}).get("iso_code") \
                or (cdata.get("continent") or {}).get("code") or "-"
            res["country"] = country
        else:
            res["country"] = "-"

        if ASN_READER:
            adata = ASN_READER.get(query_ip) or {}
            res["isp"] = adata.get("autonomous_system_organization") \
                or adata.get("isp") or "-"
        else:
            res["isp"] = "-"
        res["error"] = None
    except Exception as e:
        res["error"] = str(e)

    if not res.get("error"):
        GEO_CACHE[cache_key] = res
    return res


def trigger_async_geo_lookup(target):
    if not CHECK_GEO_IPS:
        return
    if not target or target in ["-", "127.0.0.1", "::1"]:
        return
    cache_key = target
    if not is_valid_ip(target):
        try:
            cache_key = socket.gethostbyname(target)
        except Exception:
            pass
    if cache_key not in GEO_CACHE:
        thread_pool.submit(lookup_geo, cache_key)


def sni_mismatch_check(conn, server_idx):
    try:
        meta = conn.get("metadata", {})
        host = str(meta.get("host") or "-")
        dip = str(meta.get("destinationIP") or "-")
        cid = conn.get("id")
        if not cid or host in ("-", "") or dip in ("-", ""):
            return
        if is_valid_ip(host):
            return
        try:
            host_ip = socket.gethostbyname(host)
        except Exception:
            return
        if host_ip == dip:
            return
        host_info = lookup_geo(host_ip)
        dip_info = lookup_geo(dip)
        isp_h = host_info.get("isp")
        isp_d = dip_info.get("isp")
        if (server_idx, cid) in GEO_CONNECTIONS_CACHE:
            return
        if isp_h and isp_d and isp_h != "-" and isp_d != "-" and isp_h != isp_d:
            flagged = dict(conn)
            flagged["_sni_suspicious"] = True
            GEO_CONNECTIONS_CACHE[(server_idx, cid)] = flagged
    except Exception:
        pass


def open_geo_modal(sip, dip, host=None):
    global MODAL_DATA

    target = dip if (dip and dip != "-") else host
    s_initial = GEO_CACHE.get(sip) if sip in GEO_CACHE else {"ip": sip or "-", "loading": True}
    d_initial = GEO_CACHE.get(target) if target in GEO_CACHE else {"ip": target or "-", "loading": True}

    with MODAL_LOCK:
        MODAL_DATA = {
            "sip": sip or "-",
            "dip": target or "-",
            "host": host or "-",
            "s_data": s_initial,
            "d_data": d_initial,
        }

    def worker():
        s_res = lookup_geo(sip)
        d_res = lookup_geo(target)
        with MODAL_LOCK:
            if MODAL_DATA:
                MODAL_DATA["s_data"] = s_res
                MODAL_DATA["d_data"] = d_res

    thread_pool.submit(worker)


