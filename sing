def get_clipboard_cmd():
    for cmd in ["pbcopy", "xclip -selection clipboard", "xsel --clipboard --input", "wl-copy"]:
        binary = cmd.split()[0]
        if subprocess.call(f"command -v {binary} >/dev/null 2>&1", shell=True) == 0:
            return cmd
    return None


CLIPBOARD_CMD = get_clipboard_cmd()


def copy_to_clipboard(text):
    if not CLIPBOARD_CMD or not text:
        return False
    try:
        proc = subprocess.Popen(CLIPBOARD_CMD, shell=True, stdin=subprocess.PIPE)
        proc.communicate(input=text.encode("utf-8"))
        return True
    except Exception:
        return False


def api_request(server, path, method="GET"):
    url = f"{server['api']}/{path.lstrip('/')}"
    headers = {}
    if server.get("secret"):
        headers["Authorization"] = f"Bearer {server['secret']}"

    req = urllib.request.Request(url, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=2) as resp:
            if resp.status == 200:
                body = resp.read().decode("utf-8")
                return json.loads(body) if body else {}
            elif resp.status == 204:
                return True
    except Exception:
        return None
    return None


def proxies_polling_loop(server):
    while True:
        data = api_request(server, "proxies", "GET")
        groups = []
        if isinstance(data, dict):
            proxies = data.get("proxies")
            if isinstance(proxies, dict):
                for name, info in proxies.items():
                    if not isinstance(info, dict):
                        continue
                    ptype = str(info.get("type", "")).lower()
                    if ptype in ("selector", "urltest"):
                        groups.append((name, str(info.get("now", "-"))))
        server["proxies"] = groups
        time.sleep(5)


def fmt_bytes(size):
    try:
        b = float(size)
    except (ValueError, TypeError):
        return "0 B"

    if b >= 1073741824:
        return f"{b / 1073741824:.1f} G"
    elif b >= 1048576:
        return f"{b / 1048576:.1f} M"
    elif b >= 1024:
        return f"{b / 1024:.1f} K"
    return f"{int(b)} B"


def clean_type(t):
    return str(t).split("/")[-1].strip() if t else " "


def parse_time(t):
    if not t:
        return " "
    t_str = str(t)
    return t_str.split("T")[1][:8] if "T" in t_str else " "


def process_connections_payload(raw_conns, server):
    server_idx = server["idx"]

    filtered = raw_conns
    active_ids = set()
    now = time.time()

    with CONNECTIONS_LOCK:
        for c in filtered:
            cid = c.get("id")
            if cid:
                key = (server_idx, cid)
                active_ids.add(key)
                CONNECTION_HISTORY[key] = {"data": c, "closed_at": None}

        expired_ids = []
        for key, info in list(CONNECTION_HISTORY.items()):
            if key[0] != server_idx:
                continue
            if key not in active_ids:
                if info["closed_at"] is None:
                    info["closed_at"] = now
                elif now - info["closed_at"] > 10:
                    expired_ids.append(key)

        for key in expired_ids:
            del CONNECTION_HISTORY[key]

        all_tracked = []
        for key, info in CONNECTION_HISTORY.items():
            if key[0] != server_idx:
                continue
            item_copy = dict(info["data"])
            item_copy["_is_closed"] = (info["closed_at"] is not None)
            all_tracked.append(item_copy)

    filtered = all_tracked

    if FILTER_QUERY:
        fq = FILTER_QUERY.lower()
        res = []
        for c in filtered:
            meta = c.get("metadata", {})
            chains = c.get("chains", [])
            chain_str = chains[0] if chains else ""

            match = (
                fq in clean_type(meta.get("type", "")).lower()
                or fq in meta.get("sourceIP", "").lower()
                or fq in meta.get("destinationIP", "").lower()
                or fq in meta.get("host", "").lower()
                or fq in meta.get("processPath", "").lower()
                or fq in str(meta.get("network", "")).lower()
                or fq in chain_str.lower()
            )
            if match:
                res.append(c)
        filtered = res

    groups = {}
    for c in filtered:
        meta = c.get("metadata", {})
        key = (
            meta.get("type"),
            meta.get("sourceIP"),
            meta.get("destinationIP"),
            meta.get("destinationPort"),
            meta.get("host"),
        )
        groups.setdefault(key, []).append(c)

    processed = []
    for key, items in groups.items():
        first = dict(items[0])
        try:
            upload = int(first.get("upload", 0))
        except (ValueError, TypeError):
            upload = 0
        try:
            download = int(first.get("download", 0))
        except (ValueError, TypeError):
            download = 0

        first["count"] = str(len(items))
        first["upload"] = upload
        first["download"] = download
        first["_is_closed"] = all(item.get("_is_closed", False) for item in items)
        processed.append(first)

    for c in processed:
        c["_server"] = server_idx
        c["_server_name"] = server["tab_name"]

        meta = c.get("metadata", {})
        sip = meta.get("sourceIP")
        if sip:
            trigger_async_geo_lookup(sip)
        dip = str(meta.get("destinationIP") or "-")
        host = str(meta.get("host") or "-")
        target_key = dip if dip != "-" else host
        if target_key:
            trigger_async_geo_lookup(target_key)
            ip_info = GEO_CACHE.get(target_key, {})
            if isinstance(ip_info, dict) and ip_info.get("country") == GEO_COUNTRY_CODE:
                cid = c.get("id")
                if cid:
                    GEO_CONNECTIONS_CACHE[(server_idx, cid)] = c

        if CHECK_GEO_IPS and ASN_READER:
            thread_pool.submit(sni_mismatch_check, c, server_idx)

    server["conns"] = processed
    merge_connections()


def merge_connections():
    global LATEST_CONNECTIONS, API_ERROR, SCROLL_OFFSET, SELECTED_ROW, AUTO_FOLLOW_MODE, SELECTED_CONN_ID

    with CONNECTIONS_LOCK:
        merged = []
        for s in SERVERS:
            merged.extend(s["conns"])

        try:
            if SORT_BY == "upload":
                merged.sort(key=lambda x: int(x.get("upload", 0) or 0), reverse=True)
            elif SORT_BY == "download":
                merged.sort(key=lambda x: int(x.get("download", 0) or 0), reverse=True)
            elif SORT_BY == "sip":
                merged.sort(key=lambda x: str(x.get("metadata", {}).get("sourceIP", "") or ""))
            elif SORT_BY == "dport":
                merged.sort(key=lambda x: int(x.get("metadata", {}).get("destinationPort", 0) or 0))
            else:  # "end" default
                merged.sort(key=lambda x: str(x.get("start", "") or ""), reverse=True)
        except Exception:
            pass

        new_len = len(merged)

        if VIEW_MODE == "all":
            view = merged
        else:
            view = [c for c in merged if c.get("_server") == VIEW_MODE]
        view_len = len(view)

        if AUTO_FOLLOW_MODE == "top":
            SCROLL_OFFSET = 0
            if SELECTED_ROW == 0:
                if view:
                    SELECTED_CONN_ID = (view[0].get("_server"), view[0].get("id"))
            elif SELECTED_CONN_ID and view:
                found_index = None
                for idx, item in enumerate(view):
                    if (item.get("_server"), item.get("id")) == SELECTED_CONN_ID:
                        found_index = idx
                        break
                if found_index is not None:
                    SELECTED_ROW = found_index
                else:
                    SELECTED_ROW = min(SELECTED_ROW, view_len - 1)
                    if view_len > 0:
                        SELECTED_CONN_ID = (view[SELECTED_ROW].get("_server"), view[SELECTED_ROW].get("id"))
        elif AUTO_FOLLOW_MODE == "bottom" and view_len > 0 and SORT_BY == "end":
            SELECTED_ROW = view_len - 1
            SELECTED_CONN_ID = (view[-1].get("_server"), view[-1].get("id"))
        elif SELECTED_CONN_ID and view:
            found_index = None
            for idx, item in enumerate(view):
                if (item.get("_server"), item.get("id")) == SELECTED_CONN_ID:
                    found_index = idx
                    break
            if found_index is not None:
                SELECTED_ROW = found_index
            else:
                SELECTED_ROW = min(SELECTED_ROW, view_len - 1)
                SELECTED_CONN_ID = (
                    (view[SELECTED_ROW].get("_server"), view[SELECTED_ROW].get("id"))
                    if view_len > 0 else None
                )

        LATEST_CONNECTIONS = merged
        API_ERROR = None


def background_websocket_loop(server):
    raw_api = server["api"].strip()
    if not raw_api.startswith(("http://", "https://", "ws://", "wss://")):
        raw_api = "http://" + raw_api

    parsed = urllib.parse.urlparse(raw_api)
    host_port = parsed.netloc if parsed.netloc else parsed.path.split('/')[0]

    scheme = "wss" if parsed.scheme in ["https", "wss"] else "ws"
    ws_url = f"{scheme}://{host_port}/connections"

    if server.get("secret"):
        ws_url += f"?secret={urllib.parse.quote(server['secret'])}"

    headers = {
        "User-Agent": "Mozilla/5.0",
        "Origin": f"http://{host_port}",
    }
    if server.get("secret"):
        headers["Authorization"] = f"Bearer {server['secret']}"

    while True:
        try:
            ws = websocket.create_connection(
                ws_url,
                header=headers,
                timeout=5,
                ping_interval=10,
                ping_timeout=5
            )
            server["alive"] = True
            server["error"] = None
            threading.Thread(target=proxies_polling_loop, args=(server,), daemon=True).start()

            while True:
                if IS_PAUSED:
                    time.sleep(0.2)
                    continue

                message = ws.recv()
                if not message:
                    break

                data = json.loads(message)
                if "connections" in data and isinstance(data["connections"], list):
                    process_connections_payload(data["connections"], server)

        except websocket.WebSocketBadStatusException as e:
            server["alive"] = False
            server["error"] = f"HTTP {e.status_code}"
            time.sleep(2)
        except Exception as e:
            server["alive"] = False
            server["error"] = f"{type(e).__name__}: {str(e)}"
            time.sleep(2)


def curses_prompt(stdscr, prompt_symbol):
    h, w = stdscr.getmaxyx()
    stdscr.nodelay(False)
    curses.echo()
    curses.curs_set(1)

    stdscr.move(h - 1, 0)
    stdscr.clrtoeol()
    stdscr.addstr(h - 1, 0, f"{prompt_symbol} ", curses.color_pair(CP_MAGENTA) | curses.A_BOLD)
    stdscr.refresh()

    try:
        input_bytes = stdscr.getstr(h - 1, len(prompt_symbol) + 1)
        val = input_bytes.decode("utf-8").strip()
    except Exception:
        val = ""

    curses.noecho()
    curses.curs_set(0)
    stdscr.nodelay(True)
    return val


def draw_modal_overlay(stdscr):
    global MODAL_WIN
    with MODAL_LOCK:
        if not MODAL_DATA:
            MODAL_WIN = None
            return
        modal_copy = dict(MODAL_DATA)

    h, w = stdscr.getmaxyx()
    box_h = min(16, h - 4)
    box_w = min(76, w - 4)
    if box_h < 8 or box_w < 30:
        return

    start_y = (h - box_h) // 2
    start_x = (w - box_w) // 2

    try:
        if MODAL_WIN is None:
            MODAL_WIN = curses.newwin(box_h, box_w, start_y, start_x)

        MODAL_WIN.erase()
        MODAL_WIN.attron(curses.color_pair(CP_MAGENTA) | curses.A_BOLD)
        MODAL_WIN.box()
        MODAL_WIN.addstr(0, 2, " Local GeoIP Connection Details ", curses.color_pair(CP_MAGENTA) | curses.A_BOLD)
        MODAL_WIN.attroff(curses.color_pair(CP_MAGENTA) | curses.A_BOLD)

        def draw_ip_block(y_offset, title, data):
            country = data.get("country") or "-"
            ip_str = data.get("ip") or "-"
            MODAL_WIN.addstr(y_offset, 2, f"{title}: [{country}] {ip_str}",
                             curses.color_pair(CP_YELLOW) | curses.A_BOLD)
            if data.get("loading"):
                MODAL_WIN.addstr(y_offset + 1, 4, "Looking up local GeoIP database...", curses.A_BOLD)
            elif data.get("error"):
                MODAL_WIN.addstr(y_offset + 1, 4, f"Info: {data['error']}", curses.color_pair(CP_ERROR) | curses.A_BOLD)
            else:
                isp = data.get("isp") or "-"
                MODAL_WIN.addstr(y_offset + 1, 4, f"ASN / Org: {isp[:box_w - 16]}", curses.A_BOLD)

        draw_ip_block(2, "Source", modal_copy.get("s_data", {}))
        draw_ip_block(7, "Destination", modal_copy.get("d_data", {}))
        host_str = modal_copy.get("host", "-")
        if host_str and host_str != "-":
            MODAL_WIN.addstr(12, 2, f"Host: {host_str[:box_w - 10]}", curses.color_pair(CP_GREEN) | curses.A_BOLD)

        MODAL_WIN.addstr(box_h - 2, 2, "Press Enter / Esc / Q to close", curses.color_pair(CP_MAGENTA) | curses.A_BOLD)
        MODAL_WIN.refresh()
    except curses.error:
        pass


def draw_main_interface(stdscr):
    global SELECTED_ROW, SCROLL_OFFSET, AUTO_FOLLOW_MODE, GEO_SELECTED_ROW, GEO_SCROLL_OFFSET

    h, w = stdscr.getmaxyx()
    max_visible_rows = max(1, h - 2)

    with CONNECTIONS_LOCK:
        if IN_GEO_VIEW:
            conns = list(GEO_CONNECTIONS_CACHE.values())
            conns.sort(key=lambda x: str(x.get("start", "") or ""), reverse=True)
        else:
            if VIEW_MODE == "all":
                conns = list(LATEST_CONNECTIONS)
            else:
                conns = [c for c in LATEST_CONNECTIONS if c.get("_server") == VIEW_MODE]
        err = API_ERROR

    if err:
        stdscr.addstr(0, 0, err, curses.color_pair(CP_ERROR) | curses.A_BOLD)
        return

    if not conns:
        msg = "No GEO connections cached." if IN_GEO_VIEW else "No active connections."
        stdscr.addstr(0, 0, msg, curses.color_pair(CP_MAGENTA) | curses.A_BOLD)

    sel_row = GEO_SELECTED_ROW if IN_GEO_VIEW else SELECTED_ROW
    scroll_off = GEO_SCROLL_OFFSET if IN_GEO_VIEW else SCROLL_OFFSET

    if sel_row >= len(conns):
        sel_row = max(0, len(conns) - 1)
        if IN_GEO_VIEW:
            GEO_SELECTED_ROW = sel_row
        else:
            SELECTED_ROW = sel_row

    if not IN_GEO_VIEW:
        if AUTO_FOLLOW_MODE == "bottom" and len(conns) > 0 and SORT_BY == "end":
            SCROLL_OFFSET = max(0, len(conns) - max_visible_rows)
        else:
            if SELECTED_ROW < SCROLL_OFFSET:
                SCROLL_OFFSET = SELECTED_ROW
            elif SELECTED_ROW >= SCROLL_OFFSET + max_visible_rows:
                SCROLL_OFFSET = SELECTED_ROW - max_visible_rows + 1

        if SCROLL_OFFSET == 0 and AUTO_FOLLOW_MODE != "bottom":
            AUTO_FOLLOW_MODE = "top"
        elif SCROLL_OFFSET > 0 and AUTO_FOLLOW_MODE == "top":
            AUTO_FOLLOW_MODE = "none"
        scroll_off = SCROLL_OFFSET
    else:
        if GEO_SELECTED_ROW < GEO_SCROLL_OFFSET:
            GEO_SCROLL_OFFSET = GEO_SELECTED_ROW
        elif GEO_SELECTED_ROW >= GEO_SCROLL_OFFSET + max_visible_rows:
            GEO_SCROLL_OFFSET = GEO_SELECTED_ROW - max_visible_rows + 1
        scroll_off = GEO_SCROLL_OFFSET

    table_data = []
    for i, c in enumerate(conns):
        meta = c.get("metadata", {})
        sip = str(meta.get("sourceIP") or "-")
        dip = str(meta.get("destinationIP") or "-")
        host = str(meta.get("host") or "-")
        target_key = dip if dip != "-" else host

        s_ip_info = GEO_CACHE.get(sip, {})
        ip_info = GEO_CACHE.get(target_key, {})

        table_data.append({
            "num": str(i + 1),
            "type": clean_type(meta.get("type")),
            "sip": sip,
            "srv": str(c.get("_server_name") or "-"),
            "scc": s_ip_info.get("country", "-") if isinstance(s_ip_info, dict) else "-",
            "count": str(c.get("count", "1")),
            "cc": ip_info.get("country", "-") if isinstance(ip_info, dict) else "-",
            "dip": dip,
            "host": host,
            "dport": str(meta.get("destinationPort") or "-"),
            "up": fmt_bytes(c.get("upload", 0)),
            "down": fmt_bytes(c.get("download", 0)),
            "time": parse_time(c.get("start")),
            "net": str(meta.get("network") or "-").upper(),
            "asn": ip_info.get("isp", "-") if isinstance(ip_info, dict) else "-",
            "raw_up": c.get("upload", 0),
            "raw_down": c.get("download", 0),
            "raw_dip": target_key,
            "raw_is_closed": c.get("_is_closed", False),
        })

    cols = ["type", "sip", "scc", "count", "cc", "dip", "host", "dport", "up", "down", "time", "net", "asn"]
    if VIEW_MODE == "all":
        cols.insert(4, "srv")
    visible_rows = table_data[scroll_off: scroll_off + max_visible_rows]

    col_widths = {k: 0 for k in cols}
    for row in visible_rows:
        for k in cols:
            col_widths[k] = max(col_widths[k], len(row[k]))

    max_visible_count_len = max([len(r["count"]) for r in visible_rows], default=1)
    col_widths["count"] = max_visible_count_len

    MAGENTA_COL_KEYS = {"count", "scc", "cc", "net", "srv", "asn"}
    GREEN_COL_KEYS = {"dip", "host"}

    for screen_y, row in enumerate(visible_rows):
        actual_idx = scroll_off + screen_y

        dip_info = GEO_CACHE.get(row["raw_dip"], {})
        is_geo = isinstance(dip_info, dict) and dip_info.get("country") == GEO_COUNTRY_CODE
        is_dead = row["raw_up"] == 0 or row["raw_down"] == 0
        is_closed = row["raw_is_closed"]

        row_color = curses.color_pair(CP_DEFAULT)
        if is_geo:
            row_color = curses.color_pair(CP_GEO)
        elif is_dead:
            row_color = curses.color_pair(CP_ERROR)
        elif is_closed:
            row_color = curses.color_pair(CP_CLOSED)

        is_selected = (actual_idx == sel_row)

        col_values = [
            ("type", row["type"].ljust(col_widths["type"])),
            ("sip", row["sip"].rjust(col_widths["sip"])),
            ("scc", row["scc"].ljust(col_widths["scc"])),
            ("count", row["count"].rjust(col_widths["count"])),
        ]
        if VIEW_MODE == "all":
            col_values.insert(4, ("srv", row["srv"].ljust(col_widths["srv"])))
        col_values += [
            ("cc", row["cc"].ljust(col_widths["cc"])),
            ("dip", row["dip"].ljust(col_widths["dip"])),
            ("host", row["host"].ljust(col_widths["host"])),
            ("dport", row["dport"].rjust(col_widths["dport"])),
            ("up", row["up"].rjust(col_widths["up"])),
            ("down", row["down"].rjust(col_widths["down"])),
            ("time", row["time"].ljust(col_widths["time"])),
            ("net", row["net"].ljust(col_widths["net"])),
            ("asn", row["asn"].ljust(col_widths["asn"])),
        ]

        curr_x = 0
        for col_idx, (col_key, col_str) in enumerate(col_values):
            if curr_x >= w:
                break

            if is_selected:
                selected_pair = curses.color_pair(CP_SEL_DEAD) if is_dead else curses.color_pair(CP_SEL)
                cell_style = selected_pair | curses.A_BOLD
            else:
                if is_dead and col_key in GREEN_COL_KEYS:
                    cell_style = curses.color_pair(CP_ERROR) | curses.A_BOLD
                elif col_key in GREEN_COL_KEYS:
                    cell_style = curses.color_pair(CP_GREEN) | curses.A_BOLD
                elif col_key in MAGENTA_COL_KEYS:
                    cell_style = curses.color_pair(CP_MAGENTA) | curses.A_BOLD
                else:
                    cell_style = row_color | curses.A_BOLD

            chunk = col_str[: w - curr_x]
            try:
                stdscr.addstr(screen_y, curr_x, chunk, cell_style)
            except curses.error:
                pass

            curr_x += len(chunk)

            if col_idx < len(col_values) - 1 and curr_x < w:
                sep_str = "  "
                sep = sep_str[: w - curr_x]
                if is_selected:
                    selected_pair = curses.color_pair(CP_SEL_DEAD) if is_dead else curses.color_pair(CP_SEL)
                    sep_style = selected_pair | curses.A_BOLD
                else:
                    sep_style = row_color | curses.A_BOLD
                try:
                    stdscr.addstr(screen_y, curr_x, sep, sep_style)
                except curses.error:
                    pass
                curr_x += len(sep)

        if is_selected:
            selected_pair = curses.color_pair(CP_SEL_DEAD) if is_dead else curses.color_pair(CP_SEL)
            try:
                if curr_x < w:
                    stdscr.addstr(screen_y, curr_x, " " * (w - curr_x), selected_pair | curses.A_BOLD)
            except curses.error:
                pass

            try:
                stdscr.chgat(screen_y, 0, w, selected_pair | curses.A_BOLD)
            except curses.error:
                pass

    sort_icon = ""
    if SORT_BY == "download":
        sort_icon = "↓"
    elif SORT_BY == "upload":
        sort_icon = "↑"
    elif SORT_BY == "sip":
        sort_icon = "IP"
    elif SORT_BY == "dport":
        sort_icon = "Port"
    elif SORT_BY == "end":
        sort_icon = "•"

    status_items = []
    if IS_PAUSED:
        status_items.append(("PAUSED", curses.color_pair(CP_MAGENTA) | curses.A_BOLD))
    else:
        status_items.append(("LIVE", curses.color_pair(CP_MAGENTA) | curses.A_BOLD))
    if not IN_GEO_VIEW:
        if AUTO_FOLLOW_MODE == "bottom" and SORT_BY == "end":
            status_items.append(("FOLLOW", curses.color_pair(CP_MAGENTA) | curses.A_BOLD))
        elif AUTO_FOLLOW_MODE == "top":
            status_items.append(("TOP", curses.color_pair(CP_MAGENTA) | curses.A_BOLD))
        if sort_icon:
            status_items.append((sort_icon, curses.color_pair(CP_MAGENTA) | curses.A_BOLD))

    for s in SERVERS:
        if VIEW_MODE != "all" and s["idx"] == VIEW_MODE:
            color = curses.color_pair(CP_DEFAULT)
        elif s["alive"]:
            color = curses.color_pair(CP_MAGENTA)
        else:
            color = curses.color_pair(CP_ERROR)
        status_items.append((f"{s['tab_name']}", color | curses.A_BOLD))

    for s in SERVERS:
        if not s["alive"]:
            continue
        for grp_name, now_out in s["proxies"]:
            status_items.append(
                (f"{grp_name}→{now_out}", curses.color_pair(CP_MAGENTA) | curses.A_BOLD)
            )

    if CHECK_GEO_IPS:
        status_items.append(("GEO", curses.color_pair(CP_MAGENTA) | curses.A_BOLD))

    with GEO_RELOAD_LOCK:
        geo_err = GEO_LOAD_ERROR
    if geo_err:
        status_items.append((f"⚠ {geo_err[:40]}", curses.color_pair(CP_ERROR) | curses.A_BOLD))
    if IN_GEO_VIEW:
        status_items.append(("CATCH", curses.color_pair(CP_MAGENTA) | curses.A_BOLD))
    geo_count = len(GEO_CONNECTIONS_CACHE)

    if FILTER_QUERY:
        status_items.append((f"Filter:{FILTER_QUERY}", curses.color_pair(CP_MAGENTA) | curses.A_BOLD))
    if IPINFO_STATUS_MSG:
        status_items.append((IPINFO_STATUS_MSG, curses.color_pair(CP_MAGENTA) | curses.A_BOLD))

    current_pos = (sel_row + 1) if conns else 0
    scroll_pct = f"[{geo_count}] {current_pos}/{len(conns)}"

    try:
        stdscr.move(h - 1, 0)
        stdscr.clrtoeol()

        curr_x = 0
        max_status_w = w - len(scroll_pct) - 2
        for idx, (text, attr) in enumerate(status_items):
            if curr_x >= max_status_w:
                break
            prefix = " " if idx > 0 else ""
            item_str = prefix + text
            chunk = item_str[: max_status_w - curr_x]
            try:
                stdscr.addstr(h - 1, curr_x, chunk, attr)
            except curses.error:
                pass
            curr_x += len(chunk)

        right_x = max(0, w - len(scroll_pct) - 1)
        stdscr.addstr(h - 1, right_x, scroll_pct, curses.color_pair(CP_MAGENTA) | curses.A_BOLD)

    except curses.error:
        pass


def update_selection_id(conns):
    global SELECTED_CONN_ID, GEO_SELECTED_CONN_ID
    if IN_GEO_VIEW:
        if 0 <= GEO_SELECTED_ROW < len(conns):
            c = conns[GEO_SELECTED_ROW]
            GEO_SELECTED_CONN_ID = (c.get("_server"), c.get("id"))
    else:
        if 0 <= SELECTED_ROW < len(conns):
            c = conns[SELECTED_ROW]
            SELECTED_CONN_ID = (c.get("_server"), c.get("id"))


def draw_ui(stdscr):
    global SORT_BY, FILTER_QUERY, CHECK_GEO_IPS, IS_PAUSED, IPINFO_STATUS_MSG
    global SELECTED_ROW, SCROLL_OFFSET, MODAL_DATA, MODAL_WIN, AUTO_FOLLOW_MODE, SELECTED_CONN_ID
    global IN_GEO_VIEW, GEO_SELECTED_ROW, GEO_SCROLL_OFFSET, GEO_SELECTED_CONN_ID
    global VIEW_MODE

    curses.use_default_colors()
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(50)

    curses.init_pair(CP_ERROR, curses.COLOR_RED, -1)
    curses.init_pair(CP_GREEN, curses.COLOR_GREEN, -1)
    curses.init_pair(CP_MAGENTA, curses.COLOR_MAGENTA, -1)
    curses.init_pair(CP_GEO, curses.COLOR_BLUE, -1)
    curses.init_pair(CP_YELLOW, curses.COLOR_YELLOW, -1)
    curses.init_pair(CP_SEL, curses.COLOR_BLACK, curses.COLOR_MAGENTA)
    curses.init_pair(CP_SEL_DEAD, curses.COLOR_BLACK, curses.COLOR_RED)
    curses.init_pair(CP_CLOSED, 8, -1)

    threading.Thread(target=geo_db_updater_loop, daemon=True).start()

    for server in SERVERS:
        threading.Thread(target=background_websocket_loop, args=(server,), daemon=True).start()

    modal_active_last_frame = False

    while True:
        key = stdscr.getch()

        with MODAL_LOCK:
            has_modal = MODAL_DATA is not None

        if has_modal:
            if not modal_active_last_frame:
                stdscr.erase()
                draw_main_interface(stdscr)
                stdscr.refresh()
                modal_active_last_frame = True

            if key in [27, ord("q"), ord("Q"), curses.KEY_ENTER, 10, 13]:
                with MODAL_LOCK:
                    MODAL_DATA = None
                    MODAL_WIN = None
                modal_active_last_frame = False
                stdscr.erase()
                draw_main_interface(stdscr)
                stdscr.refresh()
                continue

            draw_modal_overlay(stdscr)
            continue

        modal_active_last_frame = False

        with CONNECTIONS_LOCK:
            if IN_GEO_VIEW:
                conns = list(GEO_CONNECTIONS_CACHE.values())
                conns.sort(key=lambda x: str(x.get("start", "") or ""), reverse=True)
            else:
                conns = list(LATEST_CONNECTIONS)

        if key in [ord("q"), ord("Q")]:
            break
        elif key == 27:
            if not IN_GEO_VIEW:
                IN_GEO_VIEW = True
                GEO_SELECTED_ROW = 0
                GEO_SCROLL_OFFSET = 0
                continue
            else:
                IN_GEO_VIEW = False
                continue
        elif key in [ord("x"), ord("X")]:
            sel_idx = GEO_SELECTED_ROW if IN_GEO_VIEW else SELECTED_ROW
            if 0 <= sel_idx < len(conns):
                conn = conns[sel_idx]
                conn_id = conn.get("id")
                if conn_id:
                    with CONNECTIONS_LOCK:
                        GEO_CONNECTIONS_CACHE[(conn.get("_server", 0), conn_id)] = conn
        elif key in [ord("p"), ord("P"), ord(" ")]:
            IS_PAUSED = not IS_PAUSED
        elif key in [ord("r"), ord("R")]:
            CHECK_GEO_IPS = not CHECK_GEO_IPS
        elif key in [ord("s"), ord("S")]:
            if not IN_GEO_VIEW:
                sort_keys = ["end", "sip", "dport", "upload", "download"]
                try:
                    curr_idx = sort_keys.index(SORT_BY)
                except ValueError:
                    curr_idx = 0
                SORT_BY = sort_keys[(curr_idx + 1) % len(sort_keys)]

                if SORT_BY != "end" and AUTO_FOLLOW_MODE == "bottom":
                    AUTO_FOLLOW_MODE = "none"

                # Run merge_connections in a separate thread so key handling never blocks the UI loop
                thread_pool.submit(merge_connections)
        elif key == curses.KEY_UP:
            if IN_GEO_VIEW:
                if GEO_SELECTED_ROW > 0:
                    GEO_SELECTED_ROW -= 1
                update_selection_id(conns)
            else:
                if SELECTED_ROW > 0:
                    SELECTED_ROW -= 1
                update_selection_id(conns)
        elif key == curses.KEY_DOWN:
            if IN_GEO_VIEW:
                if GEO_SELECTED_ROW < len(conns) - 1:
                    GEO_SELECTED_ROW += 1
                update_selection_id(conns)
            else:
                if SELECTED_ROW < len(conns) - 1:
                    SELECTED_ROW += 1
                    if SELECTED_ROW == len(conns) - 1 and SORT_BY == "end":
                        AUTO_FOLLOW_MODE = "bottom"
                elif SORT_BY == "end":
                    AUTO_FOLLOW_MODE = "bottom"
                update_selection_id(conns)
        elif key in [curses.KEY_HOME, ord("g")]:
            if IN_GEO_VIEW:
                GEO_SELECTED_ROW = 0
                GEO_SCROLL_OFFSET = 0
                update_selection_id(conns)
            else:
                SELECTED_ROW = 0
                SCROLL_OFFSET = 0
                AUTO_FOLLOW_MODE = "top"
                update_selection_id(conns)
        elif key in [curses.KEY_END, ord("G")]:
            if conns:
                if IN_GEO_VIEW:
                    GEO_SELECTED_ROW = len(conns) - 1
                    update_selection_id(conns)
                else:
                    SELECTED_ROW = len(conns) - 1
                    if SORT_BY == "end":
                        AUTO_FOLLOW_MODE = "bottom"
                    update_selection_id(conns)
        elif key == curses.KEY_NPAGE:
            h, _ = stdscr.getmaxyx()
            page_size = max(1, h - 2)
            if IN_GEO_VIEW:
                GEO_SELECTED_ROW = min(len(conns) - 1, GEO_SELECTED_ROW + page_size)
                update_selection_id(conns)
            else:
                SELECTED_ROW = min(len(conns) - 1, SELECTED_ROW + page_size)
                if SELECTED_ROW == len(conns) - 1 and SORT_BY == "end":
                    AUTO_FOLLOW_MODE = "bottom"
                update_selection_id(conns)
        elif key == curses.KEY_PPAGE:
            h, _ = stdscr.getmaxyx()
            page_size = max(1, h - 2)
            if IN_GEO_VIEW:
                GEO_SELECTED_ROW = max(0, GEO_SELECTED_ROW - page_size)
                update_selection_id(conns)
            else:
                SELECTED_ROW = max(0, SELECTED_ROW - page_size)
                update_selection_id(conns)
        elif key in [curses.KEY_ENTER, 10, 13]:
            sel_idx = GEO_SELECTED_ROW if IN_GEO_VIEW else SELECTED_ROW
            if 0 <= sel_idx < len(conns):
                meta = conns[sel_idx].get("metadata", {})
                sip = meta.get("sourceIP")
                dip = meta.get("destinationIP")
                host = meta.get("host")
                open_geo_modal(sip, dip, host)

        elif key in [ord("f"), ord("F")]:
            if not IN_GEO_VIEW:
                FILTER_QUERY = curses_prompt(stdscr, " Filter:")
                update_selection_id(conns)

        elif key in [ord("k"), ord("K")]:
            sel_idx = GEO_SELECTED_ROW if IN_GEO_VIEW else SELECTED_ROW
            if 0 <= sel_idx < len(conns):
                conn = conns[sel_idx]
                conn_id = conn.get("id")
                server = SERVERS[conn.get("_server", 0)]
                if conn_id:
                    threading.Thread(
                        target=api_request,
                        args=(server, f"connections/{conn_id}", "DELETE"),
                        daemon=True,
                    ).start()
                    IPINFO_STATUS_MSG = f"Killed #{sel_idx + 1}"
        elif key == ord("c"):
            sel_idx = GEO_SELECTED_ROW if IN_GEO_VIEW else SELECTED_ROW
            if 0 <= sel_idx < len(conns):
                meta = conns[sel_idx].get("metadata", {})
                target = meta.get("destinationIP") or meta.get("host") or "-"
                IPINFO_STATUS_MSG = f"Copied {target}" if copy_to_clipboard(target) else "Clipboard failed"
        elif key == ord("C"):
            sel_idx = GEO_SELECTED_ROW if IN_GEO_VIEW else SELECTED_ROW
            if 0 <= sel_idx < len(conns):
                sip = conns[sel_idx].get("metadata", {}).get("sourceIP")
                IPINFO_STATUS_MSG = f"Copied {sip}" if copy_to_clipboard(sip) else "Clipboard failed"
        elif key == ord("d"):
            sel_idx = GEO_SELECTED_ROW if IN_GEO_VIEW else SELECTED_ROW
            if 0 <= sel_idx < len(conns):
                meta = conns[sel_idx].get("metadata", {})
                host_val = meta.get("host") or "-"
                IPINFO_STATUS_MSG = f"Copied {host_val}" if copy_to_clipboard(host_val) else "Clipboard failed"

        elif key == ord('\t'):
            if VIEW_MODE == "all":
                VIEW_MODE = 0 if SERVERS else "all"
            elif isinstance(VIEW_MODE, int) and VIEW_MODE + 1 < len(SERVERS):
                VIEW_MODE += 1
            else:
                VIEW_MODE = "all"
            SELECTED_ROW = 0
            SCROLL_OFFSET = 0
            SELECTED_CONN_ID = None
            AUTO_FOLLOW_MODE = "top"

        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if IN_GEO_VIEW:
                sel_idx = GEO_SELECTED_ROW
                if 0 <= sel_idx < len(conns):
                    conn = conns[sel_idx]
                    key_pair = (conn.get("_server", 0), conn.get("id"))
                    if key_pair[1]:
                        with CONNECTIONS_LOCK:
                            GEO_CONNECTIONS_CACHE.pop(key_pair, None)
                        if GEO_SELECTED_ROW >= len(GEO_CONNECTIONS_CACHE):
                            GEO_SELECTED_ROW = max(0, len(GEO_CONNECTIONS_CACHE) - 1)

        stdscr.erase()
        draw_main_interface(stdscr)
        stdscr.refresh()


