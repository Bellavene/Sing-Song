def load_config():
    if not os.path.exists(CONFIG_PATH):
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        try:
            with open(CONFIG_PATH, "w") as f:
                json.dump(DEFAULT_CONFIG, f, indent=2)
        except Exception:
            pass
    try:
        with open(CONFIG_PATH, "r") as f:
            cfg = json.load(f)
    except Exception:
        cfg = dict(DEFAULT_CONFIG)

    max_servers = int(cfg.get("max_servers", 9) or 9)
    max_servers = max(1, min(9, max_servers))

    servers = cfg.get("servers")
    if not isinstance(servers, list) or not servers:
        servers = DEFAULT_CONFIG["servers"]
    servers = [s for s in servers if isinstance(s, dict) and s.get("api")][:max_servers]
    if not servers:
        servers = [dict(DEFAULT_CONFIG["servers"][0])]
    for s in servers:
        s.setdefault("secret", "")
        s.setdefault("tab_name", "?")
        s["api"] = str(s["api"]).strip()

    cfg["servers"] = servers
    cfg.setdefault("geo_country_code", "RU")
    return cfg


